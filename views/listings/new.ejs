<% layout("/layouts/boilerplate.ejs") %>

<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h2>Create New Listings</h2>

      <form method="POST" action="/listings" class="needs-validation" novalidate>
        <div class="mb-3">
          <label class="form-label">Title</label>
          <input name="listing[title]" placeholder="Enter Title" type="text" class="form-control" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea name="listing[description]" placeholder="Write Description" class="form-control" required></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Add Image URL</label>
          <input name="listing[image]" type="text" class="form-control" placeholder="Paste image URL">
          <div class="form-text text-muted">Leave blank to use default image</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label class="form-label">Price</label>
            <input name="listing[price]" placeholder="Enter Price" type="text" class="form-control" required>
          </div>

          <div class="mb-3 col-md-4">
            <label class="form-label">Country</label>
            <input name="listing[country]" placeholder="Enter Country Name" type="text" class="form-control" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Location</label>
          <input name="listing[location]" placeholder="Enter Location Name" type="text" class="form-control" required>
        </div>

        <button class="btn btn-dark mt-3 mb-4">Add New Listing</button>
      </form>
    </div>
  </div>
</body>
